{
  "manifest_version": 3,
  "name": "TikTok Studio Private",
  "version": "1.0.6",
  "description": "Ẩn bài TikTok sang Chỉ mình tôi; và lưu nhanh kênh YouTube vào Bookmark Key của Social Manager.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://social-manager.congtrieugvm.workers.dev/*"],
  "action": {
    "default_title": "TikTok Studio Private",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://www.tiktok.com/*"],
    "js": ["shared.js", "engine.js", "adapter.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }, {
    "matches": ["https://www.youtube.com/*"],
    "js": ["youtube.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
